# Copy to .env.local (git-ignored) to let Nolan OS email invoices directly. Optional.
# Gmail: turn on 2-Step Verification, then create an "App password" and paste it below.
NOLAN_SMTP_HOST=smtp.gmail.com
NOLAN_SMTP_PORT=465
NOLAN_SMTP_USER=you@gmail.com
NOLAN_SMTP_PASS=your-16-letter-app-password
NOLAN_SMTP_FROM="Nolan <you@gmail.com>"
